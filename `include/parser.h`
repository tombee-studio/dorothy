#pragma once
#include "lexer.h"
#include "ast.h"
#include <vector>
#include <stdexcept>

class Parser {
public:
    Parser(const std::vector<Token>& tokens);
    ASTNodePtr parse();

private:
    std::vector<Token> tokens;
    int pos;

    Token current();
    Token peek(int offset = 1);
    Token consume();
    Token expect(TokenType type);
    bool check(TokenType type);
    bool match(TokenType type);

    // Top-level
    ASTNodePtr parseProgram();
    ASTNodePtr parseTopLevel();
    ASTNodePtr parseFuncDef();
    ASTNodePtr parseStructDef();
    ASTNodePtr parseImport();

    // Struct internals
    ASTNodePtr parseConstructorDef(const std::string& structName);
    ASTNodePtr parseMethodDef(const std::string& structName);

    // Statements
    ASTNodePtr parseBlock();
    ASTNodePtr parseStatement();
    ASTNodePtr parseVarDecl();
    ASTNodePtr parseIfStmt();
    ASTNodePtr parseWhileStmt();
    ASTNodePtr parseForStmt();
    ASTNodePtr parseReturnStmt();
    ASTNodePtr parseExprStmt();

    // Expressions
    ASTNodePtr parseExpr();
    ASTNodePtr parseAssign();
    ASTNodePtr parseComparison();
    ASTNodePtr parseAddSub();
    ASTNodePtr parseMulDiv();
    ASTNodePtr parseUnary();
    ASTNodePtr parsePostfix();
    ASTNodePtr parsePrimary();

    // Type parsing
    TypeInfo parseType();
    TypeInfo parseTypeAnnotation(); // parses ": type"
    std::vector<Param> parseParams();
    std::vector<Param> parseStructMembers(const std::string& structName,
                                           std::vector<ASTNodePtr>& methods);
};
