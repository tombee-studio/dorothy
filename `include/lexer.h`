#pragma once
#include <string>
#include <vector>

using namespace std;

enum class TokenType {
    INT_LITERAL,
    FLOAT_LITERAL,
    DOUBLE_LITERAL,
    CHAR_LITERAL,
    STRING_LITERAL,
    IDENTIFIER,
    // Keywords
    KW_FUNC,
    KW_RETURN,
    KW_IF,
    KW_ELSE,
    KW_WHILE,
    KW_FOR,
    KW_VAR,
    KW_IMPORT,
    KW_STRUCT,
    KW_CONSTRUCTOR,
    KW_THIS,
    KW_VOID,
    KW_INT,
    KW_FLOAT,
    KW_DOUBLE,
    KW_CHAR,
    KW_LONG,
    // Operators
    PLUS,
    MINUS,
    STAR,
    SLASH,
    PERCENT,
    EQ,
    NEQ,
    LT,
    LE,
    GT,
    GE,
    ASSIGN,
    PLUS_ASSIGN,
    MINUS_ASSIGN,
    STAR_ASSIGN,
    SLASH_ASSIGN,
    AMPERSAND,
    // Delimiters
    LPAREN,
    RPAREN,
    LBRACE,
    RBRACE,
    LBRACKET,
    RBRACKET,
    SEMICOLON,
    COLON,
    COMMA,
    DOT,
    // Special
    END_OF_FILE
};

struct Token {
    TokenType type;
    string value;
    int line;
    
    Token(TokenType type, string value, int line = 0)
        : type(type), value(value), line(line) {}
};

class Lexer {
public:
    Lexer(const string& source);
    vector<Token> tokenize();
    
private:
    string source;
    int pos;
    int line;
    
    char current();
    char peek(int offset = 1);
    void advance();
    void skip_whitespace_and_comments();
    Token read_number();
    Token read_string();
    Token read_identifier();
};
