#!/bin/bash

# Save stdin (push info from git) before make test consumes it
PUSH_INFO=$(cat)

echo "[pre-push] Running tests..."
make test
if [ $? -ne 0 ]; then
    echo "[pre-push] Tests failed. Push aborted."
    exit 1
fi
echo "[pre-push] All tests passed."

# Load environment variables from .envrc
REPO_ROOT=$(git rev-parse --show-toplevel)
if [ -f "$REPO_ROOT/.envrc" ]; then
  source "$REPO_ROOT/.envrc"
fi

if [ -z "$TOOL_API_URL" ] || [ -z "$TOOL_API_KEY" ] || [ -z "$TOOL_USER_ID" ]; then
  echo "[pre-push] TOOL_API_URL, TOOL_API_KEY, TOOL_USER_ID が未設定のためタスクコメントをスキップします"
  exit 0
fi

post_comment() {
  local COMMIT_ID=$1
  local COMMIT_MSG=$(git log -1 --pretty=%B "$COMMIT_ID")
  local TASK_ID=$(echo "$COMMIT_MSG" | grep -oE 'Task: \[?[0-9]+' | grep -oE '[0-9]+' | head -1)

  if [ -z "$TASK_ID" ]; then
    return
  fi

  local COMMENT="commit: $COMMIT_ID"
  local RESPONSE=$(curl -s -o /dev/null -w "%{http_code}" -X POST "${TOOL_API_URL}task_app/comments/" \
    -H "X-API-Key: $TOOL_API_KEY" \
    -H "Content-Type: application/json" \
    -d "{\"author\": $TOOL_USER_ID, \"task\": $TASK_ID, \"description\": \"$COMMENT\"}")

  if [ "$RESPONSE" = "200" ] || [ "$RESPONSE" = "201" ]; then
    echo "[pre-push] タスク #$TASK_ID にコメントを追加しました: $COMMIT_ID"
  else
    echo "[pre-push] タスク #$TASK_ID へのコメント追加に失敗しました (HTTP $RESPONSE)"
  fi
}

ZERO_SHA="0000000000000000000000000000000000000000"
PROCESSED=0

# Try stdin-based approach (normal terminal push)
while IFS= read -r line; do
  read -r local_ref local_sha remote_ref remote_sha <<< "$line"
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "$ZERO_SHA" ] && continue

  if [ "$remote_sha" = "$ZERO_SHA" ] || [ -z "$remote_sha" ]; then
    COMMITS=$(git log --pretty=format:"%H" "$local_sha" --not --remotes 2>/dev/null)
  else
    COMMITS=$(git log --pretty=format:"%H" "$remote_sha..$local_sha")
  fi

  for COMMIT_ID in $COMMITS; do
    post_comment "$COMMIT_ID"
    PROCESSED=$((PROCESSED + 1))
  done
done <<< "$PUSH_INFO"

# Fallback: compare with upstream if stdin gave no commits
if [ "$PROCESSED" -eq 0 ]; then
  if UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null); then
    COMMITS=$(git log --pretty=format:"%H" "$UPSTREAM..HEAD")
  else
    COMMITS=$(git log --pretty=format:"%H" --not --remotes)
  fi

  for COMMIT_ID in $COMMITS; do
    post_comment "$COMMIT_ID"
  done
fi
