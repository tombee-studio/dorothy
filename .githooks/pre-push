#!/bin/bash
echo "[pre-push] Running tests..."
make test
if [ $? -ne 0 ]; then
    echo "[pre-push] Tests failed. Push aborted."
    exit 1
fi
echo "[pre-push] All tests passed."

# Load environment variables from .envrc
REPO_ROOT=$(git rev-parse --show-toplevel)
if [ -f "$REPO_ROOT/.envrc" ]; then
  source "$REPO_ROOT/.envrc"
fi

if [ -z "$TOOL_API_URL" ] || [ -z "$TOOL_API_KEY" ] || [ -z "$TOOL_USER_ID" ]; then
  echo "[pre-push] TOOL_API_URL, TOOL_API_KEY, TOOL_USER_ID が未設定のためタスクコメントをスキップします"
  exit 0
fi

# Get commits not yet pushed to any remote
if UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null); then
  COMMITS=$(git log --pretty=format:"%H" "$UPSTREAM..HEAD")
else
  COMMITS=$(git log --pretty=format:"%H" --not --remotes)
fi

for COMMIT_ID in $COMMITS; do
  COMMIT_MSG=$(git log -1 --pretty=%B "$COMMIT_ID")
  TASK_ID=$(echo "$COMMIT_MSG" | grep -oE 'Task: \[?[0-9]+' | grep -oE '[0-9]+' | head -1)

  if [ -z "$TASK_ID" ]; then
    continue
  fi

  COMMENT="commit: $COMMIT_ID"
  RESPONSE=$(curl -s -o /dev/null -w "%{http_code}" -X POST "${TOOL_API_URL}task_app/comments/" \
    -H "X-API-Key: $TOOL_API_KEY" \
    -H "Content-Type: application/json" \
    -d "{\"author\": $TOOL_USER_ID, \"task\": $TASK_ID, \"description\": \"$COMMENT\"}")

  if [ "$RESPONSE" = "200" ] || [ "$RESPONSE" = "201" ]; then
    echo "[pre-push] タスク #$TASK_ID にコメントを追加しました: $COMMIT_ID"
  else
    echo "[pre-push] タスク #$TASK_ID へのコメント追加に失敗しました (HTTP $RESPONSE)"
  fi
done
