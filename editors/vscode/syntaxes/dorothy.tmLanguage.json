{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Dorothy",
  "scopeName": "source.dorothy",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#class-declaration" },
    { "include": "#function-declaration" },
    { "include": "#support-functions" },
    { "include": "#constants" },
    { "include": "#keywords" },
    { "include": "#storage" },
    { "include": "#types" },
    { "include": "#function-call" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#member-access" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.dorothy",
          "match": "//.*$"
        },
        {
          "name": "comment.block.dorothy",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.dorothy",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#string-escapes" }
          ]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.dorothy",
          "match": "\\\\([nrt\\\\\"0]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
        },
        {
          "name": "invalid.illegal.unknown-escape.dorothy",
          "match": "\\\\."
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.dorothy",
          "match": "'(\\\\([nrt\\\\'0]|x[0-9a-fA-F]{2}|.)|[^'\\\\])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.dorothy",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.hexadecimal.dorothy",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.integer.dorothy",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.null.dorothy",
          "match": "\\bnull\\b"
        },
        {
          "name": "variable.language.this.dorothy",
          "match": "\\bthis\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.dorothy",
          "match": "\\b(if|else|while|for|return)\\b"
        },
        {
          "name": "keyword.control.import.dorothy",
          "match": "\\bimport\\b"
        }
      ]
    },
    "storage": {
      "patterns": [
        {
          "name": "storage.type.variable.dorothy",
          "match": "\\b(var|let)\\b"
        },
        {
          "name": "storage.type.function.dorothy",
          "match": "\\bfunc\\b"
        },
        {
          "name": "storage.type.class.dorothy",
          "match": "\\b(struct|class)\\b"
        },
        {
          "name": "storage.type.constructor.dorothy",
          "match": "\\bconstructor\\b"
        },
        {
          "name": "storage.modifier.dorothy",
          "match": "\\b(abstract|override)\\b"
        }
      ]
    },
    "class-declaration": {
      "match": "\\b(abstract\\s+)?(class|struct)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*))?",
      "captures": {
        "1": {
          "name": "storage.modifier.dorothy"
        },
        "2": {
          "name": "storage.type.class.dorothy"
        },
        "3": {
          "name": "entity.name.type.class.dorothy"
        },
        "4": {
          "name": "keyword.operator.inheritance.dorothy"
        },
        "5": {
          "name": "entity.other.inherited-class.dorothy"
        }
      }
    },
    "function-declaration": {
      "match": "\\b(?:(override|abstract)\\s+)?(func)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "storage.modifier.dorothy"
        },
        "2": {
          "name": "storage.type.function.dorothy"
        },
        "3": {
          "name": "entity.name.function.dorothy"
        }
      }
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.dorothy",
          "match": "\\b(int|long|char|float|double|string|String)\\b"
        },
        {
          "name": "entity.name.type.dorothy",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "support-functions": {
      "patterns": [
        {
          "name": "support.function.c-library.dorothy",
          "match": "\\b(puts|printf|scanf|malloc|free|print_int|print_str|alloc|exit)\\b"
        },
        {
          "name": "support.function.sdl.dorothy",
          "match": "\\bSDL_[A-Za-z0-9_]+\\b"
        },
        {
          "name": "support.function.glinda.dorothy",
          "match": "\\bglinda_[A-Za-z0-9_]+\\b"
        }
      ]
    },
    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.dorothy"
        }
      }
    },
    "member-access": {
      "match": "\\.([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "variable.other.property.dorothy"
        }
      }
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.dorothy",
          "match": "->"
        },
        {
          "name": "keyword.operator.comparison.dorothy",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.dorothy",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.dorothy",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.logical.dorothy",
          "match": "(!|&&|\\|\\||&|\\||\\^)"
        },
        {
          "name": "keyword.operator.null-safe.dorothy",
          "match": "\\?"
        },
        {
          "name": "punctuation.separator.dorothy",
          "match": "[,;]"
        },
        {
          "name": "punctuation.delimiter.dorothy",
          "match": ":"
        }
      ]
    }
  }
}
