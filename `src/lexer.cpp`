#include "lexer.h"
#include <stdexcept>
#include <cctype>

Lexer::Lexer(const string& source) : source(source), pos(0), line(1) {}

char Lexer::current() {
    if (pos >= (int)source.size()) return '\0';
    return source[pos];
}

char Lexer::peek(int offset) {
    int p = pos + offset;
    if (p >= (int)source.size()) return '\0';
    return source[p];
}

void Lexer::advance() {
    if (pos < (int)source.size()) {
        if (source[pos] == '\n') line++;
        pos++;
    }
}

void Lexer::skip_whitespace_and_comments() {
    while (pos < (int)source.size()) {
        if (isspace(current())) {
            advance();
        } else if (current() == '/' && peek() == '/') {
            while (pos < (int)source.size() && current() != '\n')
                advance();
        } else if (current() == '/' && peek() == '*') {
            advance(); advance();
            while (pos < (int)source.size()) {
                if (current() == '*' && peek() == '/') {
                    advance(); advance();
                    break;
                }
                advance();
            }
        } else {
            break;
        }
    }
}

Token Lexer::read_number() {
    string num;
    bool is_float = false;
    int start_line = line;
    
    while (pos < (int)source.size() && (isdigit(current()) || current() == '.')) {
        if (current() == '.') {
            if (is_float) break;
            is_float = true;
        }
        num += current();
        advance();
    }
    
    if (is_float) {
        if (current() == 'f' || current() == 'F') {
            advance();
            return Token(TokenType::FLOAT_LITERAL, num, start_line);
        }
        return Token(TokenType::DOUBLE_LITERAL, num, start_line);
    }
    return Token(TokenType::INT_LITERAL, num, start_line);
}

Token Lexer::read_string() {
    string str;
    int start_line = line;
    advance(); // skip opening quote
    while (pos < (int)source.size() && current() != '"') {
        if (current() == '\\') {
            advance();
            switch (current()) {
                case 'n': str += '\n'; break;
                case 't': str += '\t'; break;
                case '\\': str += '\\'; break;
                case '"': str += '"'; break;
                default: str += current(); break;
            }
        } else {
            str += current();
        }
        advance();
    }
    advance(); // skip closing quote
    return Token(TokenType::STRING_LITERAL, str, start_line);
}

Token Lexer::read_identifier() {
    string id;
    int start_line = line;
    while (pos < (int)source.size() && (isalnum(current()) || current() == '_')) {
        id += current();
        advance();
    }
    
    // Keywords
    if (id == "func") return Token(TokenType::KW_FUNC, id, start_line);
    if (id == "return") return Token(TokenType::KW_RETURN, id, start_line);
    if (id == "if") return Token(TokenType::KW_IF, id, start_line);
    if (id == "else") return Token(TokenType::KW_ELSE, id, start_line);
    if (id == "while") return Token(TokenType::KW_WHILE, id, start_line);
    if (id == "for") return Token(TokenType::KW_FOR, id, start_line);
    if (id == "var") return Token(TokenType::KW_VAR, id, start_line);
    if (id == "import") return Token(TokenType::KW_IMPORT, id, start_line);
    if (id == "struct") return Token(TokenType::KW_STRUCT, id, start_line);
    if (id == "constructor") return Token(TokenType::KW_CONSTRUCTOR, id, start_line);
    if (id == "this") return Token(TokenType::KW_THIS, id, start_line);
    if (id == "void") return Token(TokenType::KW_VOID, id, start_line);
    if (id == "int") return Token(TokenType::KW_INT, id, start_line);
    if (id == "float") return Token(TokenType::KW_FLOAT, id, start_line);
    if (id == "double") return Token(TokenType::KW_DOUBLE, id, start_line);
    if (id == "char") return Token(TokenType::KW_CHAR, id, start_line);
    if (id == "long") return Token(TokenType::KW_LONG, id, start_line);
    
    return Token(TokenType::IDENTIFIER, id, start_line);
}

vector<Token> Lexer::tokenize() {
    vector<Token> tokens;
    
    while (true) {
        skip_whitespace_and_comments();
        if (pos >= (int)source.size()) {
            tokens.push_back(Token(TokenType::END_OF_FILE, "", line));
            break;
        }
        
        int start_line = line;
        char c = current();
        
        if (isdigit(c)) {
            tokens.push_back(read_number());
        } else if (c == '"') {
            tokens.push_back(read_string());
        } else if (isalpha(c) || c == '_') {
            tokens.push_back(read_identifier());
        } else {
            switch (c) {
                case '+':
                    advance();
                    if (current() == '=') { advance(); tokens.push_back(Token(TokenType::PLUS_ASSIGN, "+=", start_line)); }
                    else tokens.push_back(Token(TokenType::PLUS, "+", start_line));
                    break;
                case '-':
                    advance();
                    if (current() == '=') { advance(); tokens.push_back(Token(TokenType::MINUS_ASSIGN, "-=", start_line)); }
                    else tokens.push_back(Token(TokenType::MINUS, "-", start_line));
                    break;
                case '*':
                    advance();
                    if (current() == '=') { advance(); tokens.push_back(Token(TokenType::STAR_ASSIGN, "*=", start_line)); }
                    else tokens.push_back(Token(TokenType::STAR, "*", start_line));
                    break;
                case '/':
                    advance();
                    if (current() == '=') { advance(); tokens.push_back(Token(TokenType::SLASH_ASSIGN, "/=", start_line)); }
                    else tokens.push_back(Token(TokenType::SLASH, "/", start_line));
                    break;
                case '%': advance(); tokens.push_back(Token(TokenType::PERCENT, "%", start_line)); break;
                case '=':
                    advance();
                    if (current() == '=') { advance(); tokens.push_back(Token(TokenType::EQ, "==", start_line)); }
                    else tokens.push_back(Token(TokenType::ASSIGN, "=", start_line));
                    break;
                case '!':
                    advance();
                    if (current() == '=') { advance(); tokens.push_back(Token(TokenType::NEQ, "!=", start_line)); }
                    else throw runtime_error("Unexpected character '!'");
                    break;
                case '<':
                    advance();
                    if (current() == '=') { advance(); tokens.push_back(Token(TokenType::LE, "<=", start_line)); }
                    else tokens.push_back(Token(TokenType::LT, "<", start_line));
                    break;
                case '>':
                    advance();
                    if (current() == '=') { advance(); tokens.push_back(Token(TokenType::GE, ">=", start_line)); }
                    else tokens.push_back(Token(TokenType::GT, ">", start_line));
                    break;
                case '&': advance(); tokens.push_back(Token(TokenType::AMPERSAND, "&", start_line)); break;
                case '(': advance(); tokens.push_back(Token(TokenType::LPAREN, "(", start_line)); break;
                case ')': advance(); tokens.push_back(Token(TokenType::RPAREN, ")", start_line)); break;
                case '{': advance(); tokens.push_back(Token(TokenType::LBRACE, "{", start_line)); break;
                case '}': advance(); tokens.push_back(Token(TokenType::RBRACE, "}", start_line)); break;
                case '[': advance(); tokens.push_back(Token(TokenType::LBRACKET, "[", start_line)); break;
                case ']': advance(); tokens.push_back(Token(TokenType::RBRACKET, "]", start_line)); break;
                case ';': advance(); tokens.push_back(Token(TokenType::SEMICOLON, ";", start_line)); break;
                case ':': advance(); tokens.push_back(Token(TokenType::COLON, ":", start_line)); break;
                case ',': advance(); tokens.push_back(Token(TokenType::COMMA, ",", start_line)); break;
                case '.': advance(); tokens.push_back(Token(TokenType::DOT, ".", start_line)); break;
                default:
                    throw runtime_error(string("Unexpected character: ") + c + " at line " + to_string(line));
            }
        }
    }
    
    return tokens;
}
