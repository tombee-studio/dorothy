// Glinda: Entity-Component SDL2 Game Framework for Dorothy
import "stdio.h";
import "string.h";
import "SDL2/SDL.h";

abstract class Component {
    var entity: Entity?;
    var next: Component?;

    abstract func getName() -> string;
    abstract func init();
    abstract func update();
    abstract func render(ren: long);
}

class Entity {
    var active: int;
    var firstComponent: Component?;
    var next: Entity?;

    func Entity() {
        this.active = 1;
        this.firstComponent = null;
        this.next = null;
    }

    func addComponent(c: Component) {
        c.entity = this;
        c.init();
        if (this.firstComponent == null) {
            this.firstComponent = c;
        } else {
            var curr: Component = this.firstComponent;
            while (curr.next != null) {
                curr = curr.next;
            }
            curr.next = c;
        }
    }

    func getComponent(name: string) -> Component? {
        var curr: Component? = this.firstComponent;
        while (curr != null) {
            let cname: string = curr.getName();
            if (cname == name) {
                return curr;
            }
            curr = curr.next;
        }
        return null;
    }

    func update() {
        if (this.active == 1) {
            var curr: Component? = this.firstComponent;
            while (curr != null) {
                curr.update();
                curr = curr.next;
            }
        }
    }

    func render(ren: long) {
        if (this.active == 1) {
            var curr: Component? = this.firstComponent;
            while (curr != null) {
                curr.render(ren);
                curr = curr.next;
            }
        }
    }
}

class Scene {
    var firstEntity: Entity?;

    func Scene() {
        this.firstEntity = null;
    }

    func addEntity(e: Entity) {
        if (this.firstEntity == null) {
            this.firstEntity = e;
        } else {
            var curr: Entity = this.firstEntity;
            while (curr.next != null) {
                curr = curr.next;
            }
            curr.next = e;
        }
    }

    func update() {
        var curr: Entity? = this.firstEntity;
        while (curr != null) {
            curr.update();
            curr = curr.next;
        }
    }

    func render(ren: long) {
        var curr: Entity? = this.firstEntity;
        while (curr != null) {
            curr.render(ren);
            curr = curr.next;
        }
    }
}

// Helper: draw filled rectangle
func glinda_draw_rect(ren: long, x: int, y: int, w: int, h: int, r: int, g: int, b: int, a: int) {
    var rect: int[4];
    rect[0] = x;
    rect[1] = y;
    rect[2] = w;
    rect[3] = h;
    SDL_SetRenderDrawColor(ren, r, g, b, a);
    SDL_RenderFillRect(ren, rect);
}

class GlindaApp {
    var window: long;
    var renderer: long;
    var running: int;
    var screenWidth: int;
    var screenHeight: int;
    var frameDelay: int;
    var scene: Scene?;
    var bgR: int;
    var bgG: int;
    var bgB: int;

    func GlindaApp(w: int, h: int) {
        this.window = 0;
        this.renderer = 0;
        this.running = 0;
        this.screenWidth = w;
        this.screenHeight = h;
        this.frameDelay = 16;
        this.scene = null;
        this.bgR = 24;
        this.bgG = 24;
        this.bgB = 32;
    }

    func setScene(s: Scene) {
        this.scene = s;
    }

    func setBackgroundColor(r: int, g: int, b: int) {
        this.bgR = r;
        this.bgG = g;
        this.bgB = b;
    }

    func setFrameDelay(ms: int) {
        this.frameDelay = ms;
    }

    func initSDL(title: string) -> int {
        let init_res: int = SDL_Init(32);
        if (init_res < 0) {
            let err_init: string = "Glinda: Failed to init SDL: %s\n";
            printf(err_init, SDL_GetError());
            return 1;
        }

        this.window = SDL_CreateWindow(title, 100, 100, this.screenWidth, this.screenHeight, 4);
        if (this.window == 0) {
            let err_win: string = "Glinda: Failed to create window: %s\n";
            printf(err_win, SDL_GetError());
            SDL_Quit();
            return 1;
        }

        this.renderer = SDL_CreateRenderer(this.window, 0 - 1, 2);
        if (this.renderer == 0) {
            this.renderer = SDL_CreateRenderer(this.window, 0 - 1, 0);
            if (this.renderer == 0) {
                let err_ren: string = "Glinda: Failed to create renderer: %s\n";
                printf(err_ren, SDL_GetError());
                SDL_DestroyWindow(this.window);
                SDL_Quit();
                return 1;
            }
        }

        this.running = 1;
        return 0;
    }

    func stop() {
        this.running = 0;
    }

    func run() {
        var event: int[24];
        while (this.running == 1) {
            while (SDL_PollEvent(event) != 0) {
                let eventType: int = event[0];
                if (eventType == 256) {
                    this.running = 0;
                }
                if (eventType == 768) {
                    let keycode: int = event[5];
                    if (keycode == 27) {
                        this.running = 0;
                    }
                }
            }

            if (this.scene != null) {
                this.scene.update();
            }

            SDL_SetRenderDrawColor(this.renderer, this.bgR, this.bgG, this.bgB, 255);
            SDL_RenderClear(this.renderer);

            if (this.scene != null) {
                this.scene.render(this.renderer);
            }

            SDL_RenderPresent(this.renderer);
            SDL_Delay(this.frameDelay);
        }

        this.cleanup();
    }

    func cleanup() {
        if (this.renderer != 0) {
            SDL_DestroyRenderer(this.renderer);
            this.renderer = 0;
        }
        if (this.window != 0) {
            SDL_DestroyWindow(this.window);
            this.window = 0;
        }
        SDL_Quit();
    }
}
