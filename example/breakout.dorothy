// Dorothy Breakout Game using Glinda Framework
import "stdio.h";
import "string.h";
import "SDL2/SDL.h";
import "../frameworks/glinda/glinda.dorothy";

// ==========================================
// 1. TransformComponent (位置・速度・サイズ)
// ==========================================
class TransformComponent: Component {
    var x: int;
    var y: int;
    var vx: int;
    var vy: int;
    var width: int;
    var height: int;

    func TransformComponent(x: int, y: int, vx: int, vy: int, w: int, h: int) {
        this.x = x;
        this.y = y;
        this.vx = vx;
        this.vy = vy;
        this.width = w;
        this.height = h;
    }

    override func getName() -> long {
        var n = "Transform";
        return n;
    }

    override func init() {}

    override func update() {
        this.x = this.x + this.vx;
        this.y = this.y + this.vy;
    }

    override func render(ren: long) {}
}

// ==========================================
// 2. RectRendererComponent (矩形描画)
// ==========================================
class RectRendererComponent: Component {
    var r: int;
    var g: int;
    var b: int;

    func RectRendererComponent(r: int, g: int, b: int) {
        this.r = r;
        this.g = g;
        this.b = b;
    }

    override func getName() -> long {
        var n = "RectRenderer";
        return n;
    }

    override func init() {}
    override func update() {}

    override func render(ren: long) {
        var tName = "Transform";
        var t: TransformComponent = this.entity.getComponent(tName);
        if (t != 0) {
            glinda_draw_rect(ren, t.x, t.y, t.width, t.height, this.r, this.g, this.b, 255);
        }
    }
}

// ==========================================
// 3. PaddleControllerComponent (パドル操作)
// ==========================================
class PaddleControllerComponent: Component {
    var speed: int;
    var minX: int;
    var maxX: int;

    func PaddleControllerComponent(speed: int, minX: int, maxX: int) {
        this.speed = speed;
        this.minX = minX;
        this.maxX = maxX;
    }

    override func getName() -> long {
        var n = "PaddleController";
        return n;
    }

    override func init() {}

    override func update() {
        var state: long = SDL_GetKeyboardState(0);
        if (state != 0) {
            var tName = "Transform";
            var t: TransformComponent = this.entity.getComponent(tName);
            if (t != 0) {
                // Left: 80, A: 4
                var left_pressed: int = 0;
                if (state[80] != 0) left_pressed = 1;
                if (state[4] != 0) left_pressed = 1;

                // Right: 79, D: 7
                var right_pressed: int = 0;
                if (state[79] != 0) right_pressed = 1;
                if (state[7] != 0) right_pressed = 1;

                if (left_pressed == 1) {
                    t.x = t.x - this.speed;
                }
                if (right_pressed == 1) {
                    t.x = t.x + this.speed;
                }

                // Clamp
                if (t.x < this.minX) {
                    t.x = this.minX;
                }
                if (t.x + t.width > this.maxX) {
                    t.x = this.maxX - t.width;
                }
            }
        }
    }

    override func render(ren: long) {}
}

// ==========================================
// 4. BlockComponent (ブロック情報)
// ==========================================
class BlockComponent: Component {
    var row: int;
    var col: int;
    var points: int;
    var alive: int;

    func BlockComponent(row: int, col: int, points: int) {
        this.row = row;
        this.col = col;
        this.points = points;
        this.alive = 1;
    }

    override func getName() -> long {
        var n = "Block";
        return n;
    }

    override func init() {}
    override func update() {}
    override func render(ren: long) {}
}

// ==========================================
// 5. GameManagerComponent (ゲーム状態管理 & HUD描画)
// ==========================================
class GameManagerComponent: Component {
    var score: int;
    var lives: int;
    var gameState: int; // 0: Playing, 1: Game Over, 2: Game Clear
    var totalBlocks: int;
    var remainingBlocks: int;
    var scene: Scene;
    var ballTrans: TransformComponent;
    var paddleTrans: TransformComponent;

    func GameManagerComponent(scene: Scene) {
        this.score = 0;
        this.lives = 3;
        this.gameState = 0;
        this.totalBlocks = 24;
        this.remainingBlocks = 24;
        this.scene = scene;
        this.ballTrans = 0;
        this.paddleTrans = 0;
    }

    override func getName() -> long {
        var n = "GameManager";
        return n;
    }

    override func init() {}

    func setReferences(ballT: TransformComponent, padT: TransformComponent) {
        this.ballTrans = ballT;
        this.paddleTrans = padT;
    }

    func onBlockHit(block: BlockComponent) {
        this.score = this.score + block.points;
        this.remainingBlocks = this.remainingBlocks - 1;
        var fmt_hit = "Hit block! Score: %d\n";
        printf(fmt_hit, this.score);

        if (this.remainingBlocks == 0) {
            this.gameState = 2;
            var fmt_clear = ">>> CONGRATULATIONS! ALL BLOCKS CLEARED! Final Score: %d <<<\n";
            printf(fmt_clear, this.score);
        }
    }

    func onBallLost() {
        this.lives = this.lives - 1;
        if (this.lives <= 0) {
            this.gameState = 1;
            var fmt_over = ">>> GAME OVER! Final Score: %d <<<\n";
            printf(fmt_over, this.score);
        } else {
            var fmt_score = "Score: %d | Lives: %d\n";
            printf(fmt_score, this.score, this.lives);
            if (this.ballTrans != 0) {
                if (this.paddleTrans != 0) {
                    this.ballTrans.x = this.paddleTrans.x + this.paddleTrans.width / 2 - this.ballTrans.width / 2;
                } else {
                    this.ballTrans.x = 315;
                }
                this.ballTrans.y = 300;
                this.ballTrans.vx = 3;
                this.ballTrans.vy = 0 - 4;
            }
        }
    }

    func restart() {
        this.score = 0;
        this.lives = 3;
        this.gameState = 0;
        this.remainingBlocks = this.totalBlocks;

        // Revive all blocks in scene
        var curr: Entity = this.scene.firstEntity;
        var bName = "Block";
        while (curr != 0) {
            var b: BlockComponent = curr.getComponent(bName);
            if (b != 0) {
                b.alive = 1;
                curr.active = 1;
            }
            curr = curr.next;
        }

        if (this.paddleTrans != 0) {
            this.paddleTrans.x = 280;
            this.paddleTrans.y = 440;
        }

        if (this.ballTrans != 0) {
            this.ballTrans.x = 315;
            this.ballTrans.y = 300;
            this.ballTrans.vx = 3;
            this.ballTrans.vy = 0 - 4;
        }

        var restart_msg = "Game Restarted!\n";
        printf(restart_msg);
        var fmt_score = "Score: %d | Lives: %d\n";
        printf(fmt_score, this.score, this.lives);
    }

    override func update() {
        // Handle restart key 'R' (Scancode 21)
        if (this.gameState != 0) {
            var state: long = SDL_GetKeyboardState(0);
            if (state != 0) {
                if (state[21] != 0) {
                    this.restart();
                }
            }
        }
    }

    override func render(ren: long) {
        // Draw walls / borders (Slate: 51, 65, 85)
        glinda_draw_rect(ren, 0, 0, 640, 10, 51, 65, 85, 255);
        glinda_draw_rect(ren, 0, 0, 10, 480, 51, 65, 85, 255);
        glinda_draw_rect(ren, 630, 0, 10, 480, 51, 65, 85, 255);

        // Draw lives indicators (Red squares: 239, 68, 68)
        var i: int = 0;
        while (i < this.lives) {
            glinda_draw_rect(ren, 20 + i * 16, 462, 10, 10, 239, 68, 68, 255);
            i = i + 1;
        }
    }
}

// ==========================================
// 6. BallPhysicsComponent (ボールの物理・当たり判定)
// ==========================================
class BallPhysicsComponent: Component {
    var scene: Scene;
    var gameManager: GameManagerComponent;
    var paddleTrans: TransformComponent;

    func BallPhysicsComponent(scene: Scene, gm: GameManagerComponent, padT: TransformComponent) {
        this.scene = scene;
        this.gameManager = gm;
        this.paddleTrans = padT;
    }

    override func getName() -> long {
        var n = "BallPhysics";
        return n;
    }

    override func init() {}

    override func update() {
        if (this.gameManager.gameState == 0) {
            var tName = "Transform";
            var t: TransformComponent = this.entity.getComponent(tName);
            if (t != 0) {
                // Left wall
                if (t.x <= 10) {
                    t.x = 10;
                    if (t.vx < 0) {
                        t.vx = 0 - t.vx;
                    }
                }

                // Right wall
                if (t.x + t.width >= 630) {
                    t.x = 630 - t.width;
                    if (t.vx > 0) {
                        t.vx = 0 - t.vx;
                    }
                }

                // Top wall
                if (t.y <= 10) {
                    t.y = 10;
                    if (t.vy < 0) {
                        t.vy = 0 - t.vy;
                    }
                }

                // Paddle collision
                if (this.paddleTrans != 0) {
                    var px: int = this.paddleTrans.x;
                    var py: int = this.paddleTrans.y;
                    var pw: int = this.paddleTrans.width;
                    var ph: int = this.paddleTrans.height;

                    if (t.y + t.height >= py) {
                        if (t.y <= py + ph) {
                            if (t.x + t.width >= px) {
                                if (t.x <= px + pw) {
                                    if (t.vy > 0) {
                                        t.vy = 0 - t.vy;
                                        t.y = py - t.height;

                                        var center_p: int = px + pw / 2;
                                        var center_b: int = t.x + t.width / 2;
                                        var diff: int = center_b - center_p;
                                        if (diff < 0 - 15) {
                                            t.vx = 0 - 4;
                                        }
                                        if (diff > 15) {
                                            t.vx = 4;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Block collisions
                var currE: Entity = this.scene.firstEntity;
                var bName = "Block";
                while (currE != 0) {
                    if (currE.active == 1) {
                        var blk: BlockComponent = currE.getComponent(bName);
                        if (blk != 0) {
                            if (blk.alive == 1) {
                                var bt: TransformComponent = currE.getComponent(tName);
                                if (bt != 0) {
                                    if (t.x + t.width >= bt.x) {
                                        if (t.x <= bt.x + bt.width) {
                                            if (t.y + t.height >= bt.y) {
                                                if (t.y <= bt.y + bt.height) {
                                                    blk.alive = 0;
                                                    currE.active = 0;
                                                    t.vy = 0 - t.vy;
                                                    this.gameManager.onBlockHit(blk);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    currE = currE.next;
                }

                // Bottom pit (Life lost)
                if (t.y > 480) {
                    this.gameManager.onBallLost();
                }
            }
        }
    }

    override func render(ren: long) {}
}

// ==========================================
// Main Function
// ==========================================
func main() -> int {
    var welcome_msg = "=== Dorothy Breakout Game Started (Glinda ECS Framework)! ===\nControls: [Left/Right] or [A/D] to move, [ESC] to quit, [R] to restart\n";
    printf(welcome_msg);

    var app: GlindaApp = GlindaApp(640, 480);
    app.setBackgroundColor(15, 23, 42); // Dark slate background

    var title = "Dorothy Breakout - Glinda ECS Framework";
    var err: int = app.initSDL(title);
    if (err != 0) {
        return 1;
    }

    var scene: Scene = Scene();

    // 1. GameManager Entity
    var gmEntity: Entity = Entity();
    var gm: GameManagerComponent = GameManagerComponent(scene);
    gmEntity.addComponent(gm);
    scene.addEntity(gmEntity);

    // 2. Paddle Entity
    var paddleEntity: Entity = Entity();
    var padTrans: TransformComponent = TransformComponent(280, 440, 0, 0, 80, 12);
    var padCtrl: PaddleControllerComponent = PaddleControllerComponent(6, 10, 630);
    var padRender: RectRendererComponent = RectRendererComponent(56, 189, 248); // Cyan
    paddleEntity.addComponent(padTrans);
    paddleEntity.addComponent(padCtrl);
    paddleEntity.addComponent(padRender);
    scene.addEntity(paddleEntity);

    // 3. Ball Entity
    var ballEntity: Entity = Entity();
    var ballTrans: TransformComponent = TransformComponent(315, 300, 3, 0 - 4, 10, 10);
    var ballPhysics: BallPhysicsComponent = BallPhysicsComponent(scene, gm, padTrans);
    var ballRender: RectRendererComponent = RectRendererComponent(255, 255, 255); // White
    ballEntity.addComponent(ballTrans);
    ballEntity.addComponent(ballPhysics);
    ballEntity.addComponent(ballRender);
    scene.addEntity(ballEntity);

    // Give references to GameManager
    gm.setReferences(ballTrans, padTrans);

    // 4. Brick Entities (3 rows x 8 columns = 24 bricks)
    var row: int = 0;
    while (row < 3) {
        var col: int = 0;
        while (col < 8) {
            var bx: int = 24 + col * 76;
            var by: int = 50 + row * 26;
            var pts: int = (3 - row) * 10;

            var r: int = 16;
            var g: int = 185;
            var b: int = 129; // Green (row 2)
            if (row == 0) {
                r = 239;
                g = 68;
                b = 68; // Red (row 0)
            }
            if (row == 1) {
                r = 245;
                g = 158;
                b = 11; // Orange (row 1)
            }

            var blockEntity: Entity = Entity();
            var bTrans: TransformComponent = TransformComponent(bx, by, 0, 0, 68, 18);
            var bComp: BlockComponent = BlockComponent(row, col, pts);
            var bRender: RectRendererComponent = RectRendererComponent(r, g, b);

            blockEntity.addComponent(bTrans);
            blockEntity.addComponent(bComp);
            blockEntity.addComponent(bRender);
            scene.addEntity(blockEntity);

            col = col + 1;
        }
        row = row + 1;
    }

    var fmt_score = "Score: %d | Lives: %d\n";
    printf(fmt_score, gm.score, gm.lives);

    app.setScene(scene);
    app.run();

    var exit_msg = "Thanks for playing Dorothy Breakout!\n";
    printf(exit_msg);

    return 0;
}
