// Dorothy Class System Demo:
// - Class definitions & constructor
// - Reference semantics (pass-by-reference)
// - Inheritance (class A: B)
// - Abstract classes & methods (abstract class, abstract func)
// - Method override & dynamic polymorphism (override func)

import "stdio.h";

abstract class Shape {
    abstract func area() -> int;
    abstract func describe();
}

class Rectangle: Shape {
    var width: int;
    var height: int;

    func Rectangle(w: int, h: int) {
        this.width = w;
        this.height = h;
    }

    override func area() -> int {
        return this.width * this.height;
    }

    override func describe() {
        let msg: string = "Rectangle(w=%d, h=%d, area=%d)\n";
        printf(msg, this.width, this.height, this.area());
    }
}

class Square: Shape {
    var side: int;

    func Square(s: int) {
        this.side = s;
    }

    override func area() -> int {
        return this.side * this.side;
    }

    override func describe() {
        let msg: string = "Square(side=%d, area=%d)\n";
        printf(msg, this.side, this.area());
    }
}

class Counter {
    var count: int;

    func Counter(initial: int) {
        this.count = initial;
    }

    func increment(delta: int) {
        this.count = this.count + delta;
    }

    func getCount() -> int {
        return this.count;
    }
}

// Modify counter via reference
func modifyCounter(c: Counter, addVal: int) {
    c.increment(addVal);
}

func printShapeInfo(s: Shape) {
    s.describe();
}

func main() -> int {
    let header: string = "=== Dorothy Class Feature Demo ===\n\n";
    printf(header);

    // 1. Reference semantics demo
    let sec1: string = "--- 1. Reference Semantics ---\n";
    printf(sec1);
    let c1: Counter = Counter(10);
    let c2: Counter = c1; // c2 references the exact same instance as c1
    let msg_init: string = "Initial c1: %d, c2: %d\n";
    printf(msg_init, c1.getCount(), c2.getCount());

    c2.increment(5);
    let msg_c2: string = "After c2.increment(5) -> c1: %d, c2: %d\n";
    printf(msg_c2, c1.getCount(), c2.getCount());

    modifyCounter(c1, 20);
    let msg_mod: string = "After modifyCounter(c1, 20) -> c1: %d, c2: %d\n\n";
    printf(msg_mod, c1.getCount(), c2.getCount());

    // 2. Inheritance & Polymorphism Demo
    let sec2: string = "--- 2. Inheritance & Polymorphism ---\n";
    printf(sec2);
    let rect: Rectangle = Rectangle(6, 7);
    let sq: Square = Square(5);

    printShapeInfo(rect);
    printShapeInfo(sq);

    let totalArea: int = rect.area() + sq.area();
    let msg_tot: string = "Total Area: %d\n\n";
    printf(msg_tot, totalArea);

    let footer: string = "=== All Class Demos Completed Successfully! ===\n";
    printf(footer);
    return 0;
}
