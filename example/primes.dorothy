import "stdio.h";

func is_prime(n: int) {
    var i: int = 2;
    if (n < 2) {
        return 0;
    }
    while (i * i <= n) {
        if (n % i == 0) {
            return 0;
        }
        i = i + 1;
    }
    return 1;
}

func main() {
    var fmt = "%d\n";
    var n: int = 2;
    while (n <= 50) {
        if (is_prime(n) == 1) {
            printf(fmt, n);
        }
        n = n + 1;
    }
    return 0;
}
