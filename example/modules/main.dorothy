import "stdio.h";
import "math_utils.dorothy";

func main(): int {
    let v1: Vector2 = Vector2(3, 4);
    let v2: Vector2 = Vector2(1, 2);

    let sum: Vector2 = add_vec(v1, v2);
    let scaled: Vector2 = scale_vec(v1, 3);
    let dot: int = dot_vec(v1, v2);

    let fmt1: string = "v1 = (%d, %d), v2 = (%d, %d)\n";
    let fmt2: string = "v1 + v2 = (%d, %d)\n";
    let fmt3: string = "v1 * 3 = (%d, %d)\n";
    let fmt4: string = "v1 . v2 = %d\n";

    printf(fmt1, v1.x, v1.y, v2.x, v2.y);
    printf(fmt2, sum.x, sum.y);
    printf(fmt3, scaled.x, scaled.y);
    printf(fmt4, dot);

    return 0;
}
