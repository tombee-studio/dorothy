import "stdio.h";

struct Point {
    var x: int;
    var y: int;

    constructor(px: int, py: int) {
        this.x = px;
        this.y = py;
    }
}

struct Rect {
    var origin: Point;
    var width: int;
    var height: int;

    constructor(x: int, y: int, w: int, h: int) {
        this.origin.x = x;
        this.origin.y = y;
        this.width = w;
        this.height = h;
    }
}

func move_point(p: Point, dx: int, dy: int) -> Point {
    let res: Point = Point(p.x + dx, p.y + dy);
    return res;
}

func calc_area(r: Rect) {
    return r.width * r.height;
}

func main() {
    let p: Point = Point(10, 20);
    let moved: Point = move_point(p, 5, -3);

    let r: Rect = Rect(moved.x, moved.y, 30, 40);
    let area: int = calc_area(r);

    let fmt1: string = "Point: (%d, %d)\n";
    let fmt2: string = "Moved Point: (%d, %d)\n";
    let fmt3: string = "Rect origin: (%d, %d), size: %dx%d, area: %d\n";

    printf(fmt1, p.x, p.y);
    printf(fmt2, moved.x, moved.y);
    printf(fmt3, r.origin.x, r.origin.y, r.width, r.height, area);

    return 0;
}
